<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".MainActivity">

    <!-- 1. BAGIAN ATAS (Logo & Judul) -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/illustrationSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Kotak Putih Ikon Topi Toga -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_white_rounded"
            android:elevation="4dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_graduation_cap" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NataEdu"
            android:textColor="@color/brand_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Belajar Mudah, Dimana Saja"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. BAGIAN TENGAH (Ilustrasi) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/illustrationSection"
        android:layout_width="240dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/footerSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerSection">

        <!-- Box Belakang (Buku) -->
        <View
            android:id="@+id/mainBox"
            android:layout_width="140dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_rounded_purple_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Pembatas Buku (Garis Tengah) -->
        <View
            android:layout_width="1dp"
            android:layout_height="80dp"
            android:background="#D0D0FF"
            app:layout_constraintBottom_toBottomOf="@id/mainBox"
            app:layout_constraintEnd_toEndOf="@id/mainBox"
            app:layout_constraintStart_toStartOf="@id/mainBox"
            app:layout_constraintTop_toTopOf="@id/mainBox" />

        <!-- Ikon Lokasi (Kiri Atas) -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="-16dp"
            android:background="@drawable/bg_rounded_purple_light"
            android:elevation="2dp"
            app:layout_constraintBottom_toTopOf="@+id/mainBox"
            app:layout_constraintEnd_toStartOf="@+id/mainBox">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_location" />
        </FrameLayout>

        <!-- Ikon Buku Hijau (Kanan Atas) -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-22dp"
            android:layout_marginTop="-22dp"
            android:background="@drawable/bg_circle_green"
            android:elevation="4dp"
            app:layout_constraintStart_toEndOf="@+id/mainBox"
            app:layout_constraintTop_toTopOf="@+id/mainBox">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. BAGIAN BAWAH (Loading) -->
    <LinearLayout
        android:id="@+id/footerSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="60"
            android:progressTint="@color/progress_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="MEMUAT KURIKULUM..."
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>