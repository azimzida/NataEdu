<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp">

    <!-- Header / Custom Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Quiz"
            android:textColor="#852E4E"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Spacer Atas agar Kotak Score Agak ke Tengah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3" />

    <!-- KOTAK BESAR SCORE (CardView Maroon) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#852E4E"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="40dp">

            <!-- Icon Piala (Sementara menggunakan Gambar Star default Android) -->
            <ImageView
                android:id="@+id/imgTrophy"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/icon_piala" />

            <!-- Teks Congrats! -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Congrats!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Teks 90% Score -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="90% Score"
                android:textColor="#00FF44"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Teks Quiz completed successfully -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Quiz completed successfully"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Detail Pertanyaan & Jawaban -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="You attempt 3 questions and\nfrom that 2 answer is correct."
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <!-- Icon Kecil Logo NataEdu di bagian Bawah Dalam Kotak -->
            <ImageView
                android:id="@+id/imgLogoSmall"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/icon_edushare_score" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Spacer Tengah untuk memberi jarak ke tombol bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- TOMBOL SEE YOUR CERTIFICATE (Menggunakan CardView agar melengkung lonjong) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnSeeCertificate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#852E4E"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="See Your Certificate"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</LinearLayout>